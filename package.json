{
  "name": "blue-eyes-infosoft-assignment-backend",
  "version": "1.0.0",
  "description": "This is an assignment of blue eyes infosoft private limited. It is a sports club management system api server. ",
  "keywords": [
    "assignment",
    "phase",
    "one",
    "sports",
    "club",
    "management",
    "system",
    "backend",
    "server"
  ],
  "license": "MIT",
  "author": "Kunal Chandra Das",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "build-schema": "ts-node script/schemaBuilder.ts",
    "build-prod-schema": "ts-node script/schemaBuilder.js",
    "db-format": "npx prisma format",
    "query-validate": "npx prisma validate",
    "generate": "npx prisma generate",
    "name-migrate": "npx prisma migrate dev --name",
    "start": "node dist/index.js",
    "dev": "nodemon --exec ts-node index.ts",
    "build": "npx tsc",
    "studio": "npx prisma studio ",
    "migrate": "cross-env RUNTIME_ENVIRONMENT=nodejs prisma migrate dev --name init && prisma generate",
    "reset-db": "npx prisma migrate reset",
    "prisma-deploy": "npx prisma migrate deploy",
    "prisma-view": "npx prisma studio",
    "test": "cross-env NODE_ENV=test dotenv -e .env.test -- vitest",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "crypto": "^1.0.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "sharp": "^0.35.3",
    "streamifier": "^0.1.1",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie": "^0.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "cross-env": "^10.1.0",
    "nodemon": "^3.1.14",
    "prisma": "^7.8.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  }
}
