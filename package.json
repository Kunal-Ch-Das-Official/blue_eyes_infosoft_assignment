{
  "name": "blue-eyes-infosoft-assignment-backend",
  "version": "1.0.0",
  "description": "This is an assignment of blue eyes infosoft private limited. It is a sports club management system api server. ",
  "keywords": [
    "assignment",
    "phase",
    "one",
    "sports",
    "club",
    "management",
    "system",
    "backend",
    "server"
  ],
  "license": "MIT",
  "author": "Kunal Chandra Das",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "build-schema": "ts-node scripts/schemaBuilder.ts",
    "build-prod-schema": "ts-node scripts/schemaBuilder.js",
    "db-format": "npx prisma format",
    "query-validate": "npx prisma validate",
    "generate": "npx prisma generate",
    "name-migrate": "npx prisma migrate dev --name",
    "start": "node dist/index.js",
    "dev": "nodemon --exec ts-node index.ts",
    "build": "npx tsc",
    "studio": "npx prisma studio ",
    "migrate": "cross-env RUNTIME_ENVIRONMENT=nodejs prisma migrate dev --name init && prisma generate",
    "reset-db": "npx prisma migrate reset",
    "prisma-deploy": "npx prisma migrate deploy",
    "prisma-view": "npx prisma studio",
    "dockerize": "cross-env RUNTIME_ENVIRONMENT=docker-container docker compose up -d --build",
    "docker-migrate-db": "cross-env RUNTIME_ENVIRONMENT=docker-container prisma migrate dev --name init && prisma generate",
    "docker-reset": "docker system prune -af --volumes",
    "test": "cross-env NODE_ENV=test dotenv -e .env.test -- vitest",
    "test:watch": "vitest --watch",
    "base64-windows": "[Convert]::ToBase64String([System.IO.File]::ReadAllBytes('.env'))",
    "base64-mac": "base64 -i .env"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2"
  }
}
