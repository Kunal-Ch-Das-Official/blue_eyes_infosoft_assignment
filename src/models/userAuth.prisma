
model user_auth {
    id String @id @default(uuid()) @unique
    fullName String
    emailId String @unique
    password String
    role Role @default(USER)

    createdAt      DateTime       @default(now())
    updatedAt      DateTime       @updatedAt

    submittedDetails player_details[] @relation("SubmittedDataByUser")
}

enum Role {
    ADMIN
    USER
}
