model player_details {
        id String @id @default(uuid()) @unique

        playerName String
        fathersName String
        mothersName String

        dateOfBirth DateTime
        currentAge String
        gender Gender

        playersPhotoUrl String
        playersPhotoPId String

        emailAddress String @unique
        contactNumber String @unique
        alternateMobileNo String? @unique


       //? Address Details 
        address String
        pinCode String
        stateOrProvince   String 
        country String

        club String
        sports String

        createdAt      DateTime       @default(now())
        updatedAt      DateTime       @updatedAt

        userId String
        userReference     user_auth @relation("SubmittedDataByUser", fields: [userId], references: [id], onDelete: Cascade)

        
        playerDocuments   players_document[] @relation("PlayersDocument")
        competitionPlayed competition_played[] @relation("CompetitionPlayed")
        

}

enum Gender {
    MALE
    FEMALE
    OTHERS
} 