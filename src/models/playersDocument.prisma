model players_document {
      id String @id @default(uuid()) @unique

      documentName String
      documentType String
      documentUrl String
      documentAccessUrl String
      documentSize Decimal  @db.Decimal(10, 2) @default(0.00)
      createdAt      DateTime       @default(now())
      updatedAt      DateTime       @updatedAt

      playerId String
      playerData  player_details @relation("PlayersDocument", fields: [playerId], references: [id], onDelete: Cascade) 

} 